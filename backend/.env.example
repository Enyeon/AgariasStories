# Copia este archivo como backend/.env y ajústalo. Ninguna variable es obligatoria.

# development | production  (production activa HSTS y oculta /api/docs)
APP_ENV=development

# Ruta del archivo SQLite (relativa a backend/ o absoluta)
DATABASE_PATH=data/agarias.db

# Carpeta con el build del frontend que servirá el backend (npm run build).
# Si no existe, el backend sólo expone la API.
FRONTEND_DIST=../frontend/dist

# Orígenes permitidos para CORS, separados por comas. Vacío = mismo origen
# (recomendado: el backend sirve el frontend, o Vite hace de proxy en desarrollo).
CORS_ORIGINS=

# Tamaño máximo de una petición (bytes). Un retrato redimensionado ocupa < 0,6 MB.
MAX_BODY_BYTES=1500000

# Límite de escrituras (crear/actualizar/eliminar) por IP y ventana de tiempo.
RATE_LIMIT_WRITES=60
RATE_LIMIT_WINDOW_SECONDS=300

# Pon true SOLO si hay un proxy inverso de confianza delante que fije X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Documentación interactiva en /api/docs (por defecto activada salvo en production)
# ENABLE_API_DOCS=true
