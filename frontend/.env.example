# Variables del frontend (opcionales). Copia como frontend/.env

# Backend al que Vite redirige /api en desarrollo (npm run dev).
VITE_DEV_API_PROXY=http://127.0.0.1:8000

# URL base de la API si el frontend se publica en otro dominio que el backend
# (en ese caso, configura también CORS_ORIGINS en el backend). Vacío = mismo origen.
VITE_API_BASE_URL=
